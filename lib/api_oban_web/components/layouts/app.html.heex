<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm dark:border-zinc-900">
    <div class="flex items-center gap-4">
      <a href="/" class="text-xl font-bold text-zinc-900 dark:text-zinc-100">
        ApiOban Task Manager
      </a>
      <p class="bg-brand/5 text-brand rounded-full px-2 font-medium leading-6">
        v<%= Application.spec(:api_oban, :vsn) %>
      </p>
    </div>
    <div class="flex items-center gap-4 font-semibold leading-6 text-zinc-900 dark:text-zinc-100">
      <a href="https://twitter.com/elixirphoenix" class="hover:text-zinc-700 dark:hover:text-zinc-300">
        @elixirphoenix
      </a>
      <a href="https://github.com/phoenixframework/phoenix" class="hover:text-zinc-700 dark:hover:text-zinc-300">
        GitHub
      </a>
      <.link patch={~p"/tasks"} class="px-2 py-1 hover:bg-zinc-100 dark:hover:bg-zinc-900 rounded-md transition-colors">
        Tasks
      </.link>
      
      <%= if @current_user do %>
        <span class="px-2"> <%= @current_user.email %> </span>
        <.link href={~p"/sign-out"} method="get" class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80 dark:bg-zinc-900 dark:hover:bg-zinc-900/80 transition-colors">
          Sign out
        </.link>
      <% else %>
        <.link href={~p"/auth/user/password/register"} class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80 dark:bg-zinc-900 dark:hover:bg-zinc-900/80 transition-colors">
          Register
        </.link>
        <.link href={~p"/auth/user/password/sign_in"} class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80 dark:bg-zinc-900 dark:hover:bg-zinc-900/80 transition-colors">
          Sign In
        </.link>
      <% end %>
    </div>
  </div>
</header>

<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </div>
</main>
